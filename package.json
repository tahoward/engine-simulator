{
  "name": "engine-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engines from a single to a V8, simulated from physics, in the browser and on the desktop, with an exhaust you build yourself",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "bench": "npm run bench -w apps/web",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "build:sim": "npm run build:sim -w apps/web",
    "desktop:dev": "npm run dev -w apps/desktop",
    "desktop:build": "npm run build -w apps/desktop"
  },
  "engines": {
    "node": ">=20.19"
  }
}
