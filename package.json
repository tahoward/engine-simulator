{
  "name": "engine-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engines from a single to a V8, simulated from physics in the browser, with an exhaust you build yourself",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vite build --config bench/vite.config.mjs --logLevel warn && node bench/dist/bench.mjs",
    "build:kernel": "node kernel/build.mjs",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "assemblyscript": "^0.28.20",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
